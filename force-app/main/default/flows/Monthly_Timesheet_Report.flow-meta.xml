    <formulas>
        <name>InvoiceType</name>
        <dataType>String</dataType>
        <expression>IF(DAY({!$Flow.CurrentDate})=29, &quot;Month&quot;,&quot;Quarter&quot;)</expression>
    </formulas>
    <formulas>
        <name>Lead_TotalHours</name>
        <dataType>String</dataType>
        <expression>TEXT(FLOOR({!Lead_Total_Minutes} / 60)) &amp; &quot; Hours &quot; &amp; TEXT(MOD({!Lead_Total_Minutes}, 60)) &amp; &quot; Minutes&quot;</expression>
    </formulas>
    <formulas>
        <name>SPT_TotalHours</name>
        <dataType>String</dataType>
        <expression>TEXT(FLOOR({!SPT_Total_Minutes} / 60)) &amp; &quot; Hours &quot; &amp; TEXT(MOD({!SPT_Total_Minutes}, 60)) &amp; &quot; Minutes&quot;</expression>
    </formulas>
    <formulas>
        <name>Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Timesheet report - Invoicing - &quot; &amp;
IF(
    {!InvoiceType} = &quot;Month&quot;,
    
    /* Case 1: Monthly → last month name */
    CASE(
        MONTH(ADDMONTHS(TODAY(), -1)),
        1, &quot;January&quot;,
        2, &quot;February&quot;,
        3, &quot;March&quot;,
        4, &quot;April&quot;,
        5, &quot;May&quot;,
        6, &quot;June&quot;,
        7, &quot;July&quot;,
        8, &quot;August&quot;,
        9, &quot;September&quot;,
        10, &quot;October&quot;,
        11, &quot;November&quot;,
        12, &quot;December&quot;,
        &quot;Unknown&quot;
    ),

    /* Case 2: Quarterly → Qx(MMM – MMM) */
    CASE(
        CEILING(MONTH(ADDMONTHS(TODAY(), -1)) / 3),
        1, &quot;Q1 (Jan - Mar)&quot;,
        2, &quot;Q2 (Apr - Jun)&quot;,
        3, &quot;Q3 (Jul - Sep)&quot;,
        4, &quot;Q4 (Oct - Dec)&quot;,
        &quot;Unknown&quot;
    )
) &amp;
&quot;  &quot; &amp; {!InvoiceType}</expression>
    </formulas>
    <formulas>
        <name>TableMonthlyTimseheetRows</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&apos; +
   &apos;&lt;td style=&quot;border: 1px solid black; text-align: center;&quot;&gt;&apos; + TEXT({!RowNumber}) + &apos;&lt;/td&gt;&apos; +
&apos;&lt;td style=&quot;border: 1px solid black;&quot;&gt;&apos; + {!Each_Active_Monthly_Account.Name} + &apos;&lt;/td&gt;&apos; +
    &apos;&lt;td style=&quot;border: 1px solid black;&quot;&gt;&apos; + {!SPT_TotalHours} + &apos;&lt;/td&gt;&apos; +
    &apos;&lt;td style=&quot;border: 1px solid black;&quot;&gt;&apos; + {!Lead_TotalHours} + &apos;&lt;/td&gt;&apos; +
&apos;&lt;/tr&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>TableQuarterlyTimesheetRow</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&apos; +
   &apos;&lt;td style=&quot;border: 1px solid black; text-align: center;&quot;&gt;&apos; + TEXT({!RowNumber}) + &apos;&lt;/td&gt;&apos; +
&apos;&lt;td style=&quot;border: 1px solid black;&quot;&gt;&apos; + {!Each_Quaterly_Active_Account.Name} + &apos;&lt;/td&gt;&apos; +
    &apos;&lt;td style=&quot;border: 1px solid black;&quot;&gt;&apos; + {!SPT_TotalHours} + &apos;&lt;/td&gt;&apos; +
    &apos;&lt;td style=&quot;border: 1px solid black;&quot;&gt;&apos; + {!Lead_TotalHours} + &apos;&lt;/td&gt;&apos; +
&apos;&lt;/tr&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>varPrevMonthEnd</name>
        <dataType>Date</dataType>
        <expression>DATE( YEAR(TODAY()), MONTH(TODAY()), 1 ) - 1</expression>
    </formulas>
    <formulas>
        <name>varPrevMonthStart</name>
        <dataType>Date</dataType>
        <expression>DATE( YEAR(TODAY()), MONTH(TODAY()) - 1, 1 )</expression>
    </formulas>
    <formulas>
        <name>varPrevQuarterEnd</name>
        <dataType>Date</dataType>
        <expression>CASE(
    CEILING(MONTH(TODAY()) / 3) - 1,
    0, DATE(YEAR(TODAY()) - 1, 12, 31), /* If current Q1 → previous Q4 */
    1, DATE(YEAR(TODAY()), 3, 31),      /* If current Q2 → previous Q1 */
    2, DATE(YEAR(TODAY()), 6, 30),      /* If current Q3 → previous Q2 */
    3, DATE(YEAR(TODAY()), 9, 30),      /* If current Q4 → previous Q3 */
    NULL
)</expression>
    </formulas>
    <formulas>
        <name>varPrevQuarterStart</name>
        <dataType>Date</dataType>
        <expression>CASE(
    CEILING(MONTH(TODAY()) / 3) - 1,
    0, DATE(YEAR(TODAY()) - 1, 10, 1),  /* If current Q1 → previous Q4 */
    1, DATE(YEAR(TODAY()), 1, 1),       /* If current Q2 → previous Q1 */
    2, DATE(YEAR(TODAY()), 4, 1),       /* If current Q3 → previous Q2 */
    3, DATE(YEAR(TODAY()), 7, 1),       /* If current Q4 → previous Q3 */
    NULL
)</expression>
    </formulas>
